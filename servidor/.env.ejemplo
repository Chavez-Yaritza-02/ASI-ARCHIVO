# Configuración NUEVA: ./asi.sh preparar solicita dominio y modalidad TLS.
# Los secretos están en .secretos/ (padre 0700), nunca en este archivo ni en el instalador.
ASI_DOMINIO=asi-archivo.example.invalid
# 'internal' solo para laboratorio/LAN/VPN; para internet, correo del responsable de TI.
ASI_TLS=internal
ASI_VERSION=1.0.0
ASI_ZONA_HORARIA=America/Mexico_City
ASI_HORA_RESPALDO=02:30
# Habilitar SI únicamente tras guardar la clave de recuperación y probar un respaldo.
ASI_RESPALDOS_HABILITADOS=NO
ASI_ARCHIVO_MAX_MB=20
ASI_OCR_PROCESOS=2
ASI_ESCUCHAR=0.0.0.0
ASI_PUERTO_HTTPS=443
ASI_PUERTO_HTTP=80
# true SOLO en una computadora de prueba con datos ficticios (permite la prueba de aceptación).
ASI_INSTANCIA_ACEPTACION=false
