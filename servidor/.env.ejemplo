# Configuración del servidor de ASI-ARCHIVO. "./asi.sh instalar" crea servidor/.env a partir
# de este archivo y genera las contraseñas. Nunca compartas ni subas servidor/.env.

# Nombre o IP con que las computadoras de Jefatura llegan al servidor (sin https://).
# Ejemplos: asi-archivo.zapopan.tecmm.edu.mx   o   192.168.10.25
ASI_DOMINIO=asi-archivo.local
# Certificado HTTPS:
#   internal          red interna (TI instala el certificado raíz en las PCs; ver manual)
#   correo@dominio    dominio público con Let's Encrypt (requiere puertos 80 y 443 abiertos)
ASI_TLS=internal

# Generadas por ./asi.sh instalar (aleatorias):
ASI_DB_CONTRASENA=
ASI_SECRET_KEY=

ASI_ZONA_HORARIA=America/Mexico_City
ASI_HORA_RESPALDO=02:30
ASI_RESPALDOS_CONSERVAR=30
ASI_ARCHIVO_MAX_MB=20
ASI_OCR_PROCESOS=2
# Puertos publicados (cambiar solo si TI lo indica)
ASI_PUERTO_HTTPS=443
ASI_PUERTO_HTTP=80
