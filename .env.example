# Copia este archivo como .env y ajusta los valores. El archivo .env NUNCA se sube a GitHub.
ASI_ENTORNO=desarrollo
# Base de datos SOLO para pruebas automáticas: se borra en cada ejecución.
ASI_TEST_DATABASE_URL=postgresql+psycopg://asi_archivo_pytest:CONTRASENA@localhost:5432/asi_archivo_pytest
ASI_DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/asi_archivo
# Genera una clave con:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
ASI_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ASI_TOKEN_MINUTOS=480
ASI_ZONA_HORARIA=America/Mexico_City
