# Copia este archivo como .env y ajusta los valores. El archivo .env NUNCA se sube a GitHub.
ASI_ENTORNO=desarrollo
# Cómo se anuncia este servidor en la franja de la aplicación (opcional):
# institucional | demostracion | revision. Sin valor se deduce del entorno.
# ASI_TIPO_SERVIDOR=revision
# Base de datos SOLO para pruebas automáticas: se borra en cada ejecución.
ASI_TEST_DATABASE_URL=postgresql+psycopg://asi_archivo_pytest:CONTRASENA@localhost:5432/asi_archivo_pytest
ASI_DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/asi_archivo
# Genera una clave con:  uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
ASI_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ASI_TOKEN_MINUTOS=480
ASI_ZONA_HORARIA=America/Mexico_City
# Archivo privado: ruta absoluta, dedicada y FUERA del repositorio y de carpetas sincronizadas.
# Usa una carpeta distinta para cada base; no apuntes a carpetas con documentos existentes.
# macOS/Linux: /ruta/privada/documentos. Windows: C:\ASI-ARCHIVO-DATOS\documentos
# ASI_ARCHIVO_RAIZ=/ruta/privada/documentos
ASI_ARCHIVO_MAX_MB=20
ASI_ARCHIVO_REQUERIR_ANTIVIRUS=true
# Ejecutable local clamscan con firmas actualizadas. Sin él, la carga queda bloqueada.
# ASI_ARCHIVO_ANTIVIRUS_CMD=/ruta/absoluta/clamscan
